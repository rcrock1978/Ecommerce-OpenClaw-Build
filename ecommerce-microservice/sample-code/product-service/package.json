{
  "name": "product-service",
  "version": "1.0.0",
  "description": "Product catalog service for e-commerce platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate": "ts-node src/database/migrations/migrate.ts",
    "seed": "ts-node src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.4.1",
    "@opentelemetry/instrumentation": "^0.41.1",
    "@opentelemetry/instrumentation-express": "^0.33.1",
    "@opentelemetry/instrumentation-http": "^0.41.1",
    "@opentelemetry/instrumentation-mongodb": "^0.37.1",
    "@opentelemetry/sdk-trace-base": "^1.15.1",
    "@opentelemetry/exporter-jaeger": "^1.18.1",
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "@elastic/elasticsearch": "^8.9.0",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.10.0",
    "prom-client": "^14.2.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "joi": "^17.9.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.5.9",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/uuid": "^9.0.4",
    "@types/bcryptjs": "^2.4.3",
    "@types/lodash": "^4.14.197",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "prettier": "^3.0.2",
    "mongodb-memory-server": "^8.13.0",
    "@types/mongoose": "^5.11.97"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["ecommerce", "microservice", "product", "catalog"],
  "author": "E-commerce Platform Team",
  "license": "MIT"
}