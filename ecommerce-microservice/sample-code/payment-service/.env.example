# Server Configuration
PORT=3005
NODE_ENV=development

# JWT Configuration
JWT_SECRET=local-dev-jwt-secret-change-in-prod
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-in-prod

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@postgres:5432/payments?sslmode=disable

# Kafka Configuration
KAFKA_BROKERS=kafka:29092

# Stripe Configuration (leave empty for mock mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
USE_STRIPE_MOCK=true